{
  "name": "epub-api",
  "version": "0.1.0",
  "private": true,
  "description": "EPUB to PDF conversion API (Playwright + Fastify)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fast-xml-parser": "^5.11.0",
    "fastify": "^5.1.0",
    "jszip": "^3.10.1",
    "playwright": "1.62.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
