# Pinned explicitly: this machine's global npm config points at a
# private corporate Artifactory mirror, which silently bakes its URLs
# into package-lock.json's resolved fields if left unpinned — works only
# on machines with access to that mirror, breaks everywhere else
# (Railway, CI, any other dev's machine). See the commit that added this
# file for the full story.
registry=https://registry.npmjs.org/
