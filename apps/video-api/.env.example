# Local dev only — Modal/Cloud Run set PORT themselves at deploy time.
PORT=8080

# Comma-separated browser origins allowed to call this API via CORS.
ALLOWED_ORIGINS=https://tool5.store,https://app.tool5.store

# Object storage (S3-compatible). Leave S3_BUCKET unset to use the local-
# disk fallback (writes to a temp dir, returns a file:// URL) — good for
# testing the render pipeline without a real bucket.
#
# Cloudflare R2 recommended for the "$5/month" budget: no egress fees,
# 10GB/month free storage. S3_REGION can stay "auto" for R2.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
SIGNED_URL_EXPIRY_SECONDS=3600

# Path to a .ttf/.otf font file for drawtext. Auto-detected in order:
# this env var -> Debian's fonts-dejavu-core path -> Windows' Arial (local
# dev only). Only set this if none of those apply to your environment.
FONT_FILE_PATH=
